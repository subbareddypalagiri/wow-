# --- required ---
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-too
DB_PATH=./data/ember.db

# --- the money rules (defaults shown) ---
CREDIT_USD=0.001        # 1 credit = $0.001
USER_SHARE=0.5          # user receives 50% of what the network really pays you
MARKUP=1.25             # user is charged real API cost x 1.25   (must stay above USER_SHARE)
AD_PAYOUT_USD=0.006     # LOW estimate per rewarded ad. Reconcile monthly with the network report
AD_DAILY_CAP=10
SIGNUP_BONUS_CREDITS=0  # free credits cost you money

# --- provider keys (only models whose key is set are offered) ---
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# --- earning networks (signing secrets from each network's dashboard) ---
SURVEY1_SECRET=
AD1_SECRET=

# --- only if the page is hosted on a different domain than the server ---
# CORS_ORIGIN=https://your-frontend.example
